#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
binary=${1:-"$repo/dist/mactrim"}
case "$binary" in /*) ;; *) binary="$repo/$binary";; esac
"$binary" --version
"$binary" build-info
MACTRIM_TEST_BINARY="$binary" cargo test --locked --test snapshots --test foreground --test executable --test terminal
