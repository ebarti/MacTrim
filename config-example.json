{
  "repo_roots": [
    "~/Developer",
    "~/Projects",
    "~/src",
    "~/Github"
  ],
  "worktree_roots": [
    "~/.codex/worktrees",
    "~/.codex-workspaces/worktrees"
  ],
  "duplicate_roots": [],
  "cache_roots": [
    "~/Library/Caches",
    "~/.cache",
    "~/.npm"
  ],
  "app_roots": [
    "/Applications",
    "/System/Applications",
    "~/Applications"
  ],
  "app_data_roots": [
    "~/Library/Caches",
    "~/Library/Preferences",
    "~/Library/Application Support",
    "~/Library/Logs",
    "~/Library/Saved Application State",
    "~/Library/Containers"
  ],
  "repo_days": 90,
  "cache_days": 30,
  "max_files": 100000,
  "max_depth": 24,
  "discovery_depth": 4,
  "system_reports": true,
  "budgets": {
    "repositories": 20000,
    "worktrees": 20000,
    "caches": 20000,
    "duplicates": 20000,
    "apps": 10000,
    "system": 5000
  },
  "storage_max_files": 50000,
  "storage_max_depth": 16,
  "github_squash": true,
  "worktree_default_ref": "",
  "retired_apps": {},
  "app_aliases": {},
  "history": {
    "enabled": true,
    "max_bytes": 16777216,
    "max_snapshots": 60,
    "max_days": 60,
    "auto_interval_seconds": 3600
  },
  "storage_cache": {
    "enabled": true,
    "max_bytes": 16777216,
    "reconcile_seconds": 604800
  }
}
