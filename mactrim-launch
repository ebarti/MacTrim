#!/bin/sh
# Isolated project launcher: no global packages or shell configuration changes.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
if [ ! -x "$project_dir/.venv/bin/mactrim" ]; then
    printf '%s\n' 'MacTrim project environment is not installed. See README installation commands.' >&2
    exit 2
fi
exec "$project_dir/.venv/bin/mactrim" "$@"
